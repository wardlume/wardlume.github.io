---
import Cmd from './Cmd.astro';
interface Item { q: string; a: string; cmd?: string; link?: { href: string; label: string } }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <div>
        <p set:html={i.a} />
        {i.cmd && <Cmd lines={i.cmd} />}
        {i.link && <a class="more" href={i.link.href}>{i.link.label} →</a>}
      </div>
    </details>
  ))}
</div>
<style>
  .faq { max-width: 780px; border-top: 1px solid var(--border-strong); }
  details { border-bottom: 1px solid var(--border-strong); }
  summary {
    cursor: pointer; list-style: none; padding: 20px 36px 20px 0; position: relative;
    font-weight: 600; font-size: 1.04rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
    font-size: 1.4rem; color: var(--muted); transition: transform 0.2s;
  }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  details > div { color: var(--muted); padding: 0 0 20px; }
  details > div p { margin: 0; }
  details > div :global(.cmd) { margin-top: 12px; }
  .more { display: inline-block; margin-top: 10px; font-size: 0.92rem; font-weight: 600; }
  details > div :global(a) { color: var(--accent); }
  details > div :global(code) { background: var(--surface-2); padding: 0.1em 0.35em; border-radius: 5px; font-size: 0.88em; }
</style>
