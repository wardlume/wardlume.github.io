---
interface Props { items: { q: string; a: string }[]; }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <div set:html={i.a} />
    </details>
  ))}
</div>
<style>
  .faq { max-width: 780px; margin: 0 auto; }
  details { border-bottom: 1px solid var(--border); }
  summary {
    cursor: pointer; list-style: none; padding: 20px 36px 20px 0; position: relative;
    font-weight: 600; font-size: 1.05rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
    font-size: 1.4rem; color: var(--muted); transition: transform 0.2s;
  }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  details > div { color: var(--muted); padding: 0 0 20px; }
  details > div :global(a) { color: var(--accent-2); }
  details > div :global(code) { background: var(--surface-2); padding: 0.1em 0.35em; border-radius: 5px; font-size: 0.88em; }
</style>
