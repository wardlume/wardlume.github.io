---
import { site } from '../site.config';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/#features', label: 'Features' },
  { href: '/docs', label: 'Docs' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/support', label: 'Support' },
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/changelog', label: 'Changelog' },
];
const active = (href: string) => href !== '/#features' && path.startsWith(href);
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Wardlume home">
      <img src="/img/icon-512.png" alt="" width="28" height="28" />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="gh" href={site.links.github} aria-label="Wardlume on GitHub" title="GitHub">
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <button class="theme" type="button" aria-label="Toggle light and dark theme" title="Theme">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9A9 9 0 0 0 12 3Zm0 16V5a7 7 0 0 1 0 14Z"/></svg>
      </button>
      <a class="btn btn-primary dl" href="/download">Download</a>
      <button class="menu" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile" aria-label="Mobile" hidden>
    <ul class="container">
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      <li><a href={site.links.github}>GitHub</a></li>
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  document.querySelector('.site-header .theme')?.addEventListener('click', () => {
    const dark = getComputedStyle(root).colorScheme.includes('dark');
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
  const btn = document.querySelector<HTMLButtonElement>('.site-header .menu');
  const mobile = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (mobile) mobile.hidden = open;
  });
  mobile?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) { mobile.hidden = true; btn?.setAttribute('aria-expanded', 'false'); }
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 24px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--text); font-weight: 700; font-size: 1.05rem; }
  .brand:hover { text-decoration: none; }
  .brand img { border-radius: 7px; }
  nav ul { list-style: none; margin: 0; padding: 0; }
  .bar nav { display: none; }
  .bar nav ul { display: flex; gap: 4px; }
  .bar nav a { color: var(--muted); padding: 8px 12px; border-radius: 8px; font-size: 0.93rem; font-weight: 500; }
  .bar nav a:hover, .bar nav a[aria-current='page'] { color: var(--text); background: var(--surface); text-decoration: none; }
  .actions { margin-left: auto; display: flex; align-items: center; gap: 6px; }
  .gh, .theme, .menu {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px;
    color: var(--muted); background: none; border: 0; cursor: pointer;
  }
  .gh:hover, .theme:hover, .menu:hover { color: var(--text); background: var(--surface); }
  .dl { padding: 9px 16px; font-size: 0.88rem; margin-left: 4px; }
  .mobile { border-top: 1px solid var(--border); background: var(--bg); }
  .mobile ul { padding-top: 8px; padding-bottom: 12px; }
  .mobile a { display: block; padding: 10px 0; color: var(--text); font-weight: 500; }
  @media (max-width: 480px) { .gh { display: none; } }
  @media (min-width: 980px) {
    .bar nav { display: block; }
    .menu { display: none; }
    .mobile { display: none; }
  }
</style>
