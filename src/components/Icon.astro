---
// One consistent set of 24×24 line icons (stroke = currentColor, styled by
// `.icon` in global.css). Replaces the emoji the site used to use as icons.
export type IconName =
  | 'terminal' | 'gauge' | 'film' | 'coffee' | 'shield' | 'fingerprint' | 'watch'
  | 'keyboard' | 'mask' | 'camera' | 'eye' | 'timer' | 'monitor' | 'lock' | 'key'
  | 'arrow' | 'check' | 'walk' | 'wifi-off' | 'download'
  | 'mail' | 'bug' | 'chat' | 'book' | 'rocket' | 'warning' | 'refresh' | 'life-buoy';
interface Props { name: IconName; class?: string; size?: number; label?: string }
const { name, class: cls = '', size, label } = Astro.props;

const paths: Record<IconName, string> = {
  terminal: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="m7 9 3 3-3 3M12.5 15H17"/>',
  gauge: '<path d="M4 20V10M10 20V4M16 20v-7M20 20H3"/>',
  film: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M7.5 4v16M16.5 4v16M3 9h4.5M3 15h4.5M16.5 9H21M16.5 15H21"/>',
  coffee: '<path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9ZM16 10.5h1.5a2.5 2.5 0 0 1 0 5H16M8 3.5c0 1 1 1.5 1 2.5M12 3.5c0 1 1 1.5 1 2.5"/>',
  shield: '<path d="M12 3 5 6v5.5c0 4.4 3 8.1 7 9.5 4-1.4 7-5.1 7-9.5V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  fingerprint: '<path d="M12 11.5v3.5M8.6 10a3.5 3.5 0 0 1 6.9.9v2.4c0 2.1-.4 3.9-1.2 5.4M8.7 13.4c0 2.4-.6 4.1-1.4 5.3M5.6 16.6c.5-1.3.8-2.7.8-4.4v-1.6a5.7 5.7 0 0 1 9.6-4.1M18 9c.3.7.5 1.5.5 2.4v1.7c0 1.5-.2 3-.6 4.3M4.4 8.3A8 8 0 0 1 12 3a8 8 0 0 1 4.7 1.5"/>',
  watch: '<rect x="6" y="6" width="12" height="12" rx="3"/><path d="M9 6l.7-3h4.6l.7 3M9 18l.7 3h4.6l.7-3M12 9.5V12l1.5 1.5"/>',
  keyboard: '<rect x="2.5" y="6" width="19" height="12" rx="2.5"/><path d="M6.5 10h.01M10 10h.01M13.5 10h.01M17 10h.01M8 14h8"/>',
  mask: '<circle cx="12" cy="12" r="9"/><path d="M8.5 9.5h.01M15.5 9.5h.01M8.5 15.5c1-.8 2.1-1.2 3.5-1.2s2.5.4 3.5 1.2"/>',
  camera: '<path d="M4 8h3l1.5-2.5h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.5"/>',
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3"/>',
  timer: '<circle cx="12" cy="13.5" r="7.5"/><path d="M12 10v3.5l2.5 1.5M9.5 2.5h5"/>',
  monitor: '<rect x="2.5" y="4" width="19" height="13" rx="2"/><path d="M8.5 21h7M12 17v4"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>',
  key: '<circle cx="8" cy="15" r="4"/><path d="m11 12 8.5-8.5M16.5 6.5l2.5 2.5M14.5 8.5 16 10"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  walk: '<circle cx="13" cy="4.5" r="1.8"/><path d="m9 21 2.5-6.5 2.5 2V21M7.5 12.5 9 9l4-1.5 2.5 4 2.5 1M11.5 14.5 13 8"/>',
  'wifi-off': '<path d="M3 3l18 18M8.5 16.5a5 5 0 0 1 7 0M5 13a10 10 0 0 1 4.6-2.6M19 13a10 10 0 0 0-2.4-1.7M2 9.5a15 15 0 0 1 4.3-2.8M22 9.5A15 15 0 0 0 11 5.6M12 20h.01"/>',
  download: '<path d="M12 3.5v12M7 10.5l5 5 5-5M4.5 20h15"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  bug: '<rect x="7" y="7.5" width="10" height="12" rx="5"/><path d="M9.5 7.5a2.5 2.5 0 0 1 5 0M12 11v8.5M3.5 13H7M17 13h3.5M4.5 8.5 7.5 10M19.5 8.5 16.5 10M4.5 18.5l3-2M19.5 18.5l-3-2"/>',
  chat: '<path d="M4 5.5h16a1 1 0 0 1 1 1V16a1 1 0 0 1-1 1h-9l-5 3.5V17H4a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1Z"/><path d="M8 10h8M8 13h5"/>',
  book: '<path d="M4 5.5A2 2 0 0 1 6 3.5h13v15H6a2 2 0 0 0-2 2v-15ZM4 20.5a2 2 0 0 1 2-2h13v2H6"/><path d="M9 8h6"/>',
  rocket: '<path d="M14 4c3.5 0 6 2.5 6 6-1.5 3-4.5 5.5-8 7l-5-5c1.5-3.5 4-6.5 7-8Z"/><circle cx="14.5" cy="9.5" r="1.8"/><path d="M7 12 4 12.5 3.5 15l3.5.5M12 17l-.5 3 2.5-.5.5-3.5M6.5 17.5 4 20"/>',
  warning: '<path d="M12 3.5 2.5 20h19L12 3.5Z"/><path d="M12 10v4.5M12 17h.01"/>',
  refresh: '<path d="M20 11a8 8 0 0 0-14.3-4.7L4 8M4 4v4h4M4 13a8 8 0 0 0 14.3 4.7L20 16M20 20v-4h-4"/>',
  'life-buoy': '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.5"/><path d="m6 6 3.5 3.5M14.5 14.5 18 18M18 6l-3.5 3.5M9.5 14.5 6 18"/>',
};
---
<svg
  class={`icon ${cls}`}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  style={size ? `width:${size}px;height:${size}px` : undefined}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={paths[name]}
/>
