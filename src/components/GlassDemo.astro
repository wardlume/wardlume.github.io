---
// Interactive in-browser demo of the ward: an agent keeps working on a mock
// Mac screen; cast the ward, try to touch it, then unlock with "Touch ID".
const packs = [
  { id: 'silent', label: 'Silent Professional' },
  { id: 'wizard', label: 'Wizard', img: '/img/reaction-wizard.jpg' },
  { id: 'grumpy', label: 'Grumpy Old Man', img: '/img/reaction-grumpyOldMan.jpg' },
];
---
<div class="demo" data-state="idle" data-pack="wizard">
  <div class="mac" tabindex="0" aria-label="Wardlume demo screen. Press Command Shift L to cast the ward.">
    <div class="menubar">
      <span class="apple"></span>
      <span class="mb-strong">Terminal</span><span>Shell</span><span>Edit</span><span class="hide-sm">View</span><span class="hide-sm">Window</span>
      <span class="spacer"></span>
      <span class="ward-icon" title="Wardlume">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Zm0 6a2.5 2.5 0 0 1 2.5 2.5V12h.5a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h.5v-1.5A2.5 2.5 0 0 1 12 8Zm0 1.3c-.66 0-1.2.54-1.2 1.2V12h2.4v-1.5c0-.66-.54-1.2-1.2-1.2Z"/></svg>
      </span>
      <span class="clock">9:41</span>
    </div>

    <div class="window">
      <div class="titlebar"><i></i><i></i><i></i><span>~/orbit — agent</span></div>
      <pre class="term" aria-hidden="true"></pre>
    </div>

    <!-- The ward -->
    <div class="ward" aria-hidden="true">
      <div class="sheen"></div>
      <div class="sheen s2"></div>
      <div class="badge">
        <svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z"/></svg>
        Warded · input locked
      </div>
      <div class="hint">Touch ID or <kbd>⌘</kbd><kbd>⇧</kbd><kbd>U</kbd> to unlock</div>
    </div>

    <div class="reaction" aria-hidden="true"><img alt="" /></div>
    <div class="nope" aria-hidden="true">ACCESS DENIED</div>

    <button class="cast" type="button">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z"/></svg>
      Activate Ward <span class="keys"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>L</kbd></span>
    </button>
  </div>

  <div class="deck">
    <div class="packs" role="radiogroup" aria-label="Reaction pack">
      {packs.map((p) => (
        <button type="button" role="radio" data-pack={p.id} aria-checked={p.id === 'wizard' ? 'true' : 'false'}>{p.label}</button>
      ))}
    </div>
    <button class="touchid" type="button" aria-label="Touch ID: unlock">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M12 11v3.5M8.5 10.5a3.5 3.5 0 0 1 7 0v2.5c0 2-.4 3.8-1.2 5.3M8.6 13.5c0 2.3-.6 4-1.4 5.2M5.6 16.8c.5-1.3.8-2.6.8-4.3v-2a5.6 5.6 0 0 1 9.4-4.1M18 9.2c.3.7.4 1.4.4 2.2v1.8c0 1.5-.2 3-.6 4.3M4.4 8.4A8 8 0 0 1 12 3a8 8 0 0 1 4.6 1.5"/></svg>
      <span>Touch ID</span>
    </button>
  </div>
  <p class="status small muted" aria-live="polite">Click <b>Activate Ward</b>, then try clicking or typing on the screen.</p>
</div>

<script>
  const LINES = [
    '~/orbit main › agent "migrate the billing tests"',
    '✻ Planning: 3 files, 48 tests',
    '● Read src/billing/invoice.ts (212 lines)',
    '● Update src/billing/invoice.ts',
    '   41 - total = items.reduce(sum)',
    '   41 + total = roundCents(items.reduce(sum))',
    '● Bash npm test -- billing',
    '  ⎿ PASS  tests/billing.spec.ts (48 tests)',
    '● Update tests/invoice.spec.ts',
    '   +  expect(invoice.total).toBe(4200)',
    '● Bash npm run typecheck',
    '  ⎿ ✓ no errors',
    '✳ Working… (41m 12s · still going)',
  ];

  for (const demo of document.querySelectorAll<HTMLElement>('.demo')) {
    const mac = demo.querySelector<HTMLElement>('.mac')!;
    const term = demo.querySelector<HTMLElement>('.term')!;
    const cast = demo.querySelector<HTMLButtonElement>('.cast')!;
    const touch = demo.querySelector<HTMLButtonElement>('.touchid')!;
    const reaction = demo.querySelector<HTMLImageElement>('.reaction img')!;
    const status = demo.querySelector<HTMLElement>('.status')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let attempts = 0;
    let hideTimer = 0;

    // The agent keeps typing whether or not the ward is up.
    let li = 6, ci = 0, buf: string[] = LINES.slice(0, 6);
    const tick = () => {
      const line = LINES[li];
      if (ci === 0) buf.push('');
      buf[buf.length - 1] = line.slice(0, ++ci);
      if (ci >= line.length) { ci = 0; li = (li + 1) % LINES.length; if (li === 0) buf = []; }
      term.textContent = buf.slice(-11).join('\n') + '▍';
      setTimeout(tick, ci === 0 ? 420 : 18 + Math.random() * 30);
    };
    if (reduced) term.textContent = LINES.slice(0, 11).join('\n');
    else tick();

    const set = (s: 'idle' | 'warded') => {
      demo.dataset.state = s;
      if (s === 'warded') {
        attempts = 0;
        status.innerHTML = 'Warded. The agent keeps working, but <b>try clicking or typing</b> on the screen.';
      } else {
        status.innerHTML = attempts
          ? `Unlocked. The ward blocked <b>${attempts}</b> attempt${attempts === 1 ? '' : 's'}; the agent never noticed.`
          : 'Unlocked. Everything is exactly where you left it.';
      }
      mac.focus({ preventScroll: true });
    };

    function choosePack(id: string) {
      demo.dataset.pack = id;
      demo.querySelectorAll('.packs button').forEach((x) =>
        x.setAttribute('aria-checked', String((x as HTMLElement).dataset.pack === id)));
    }

    const intrude = () => {
      attempts++;
      const pack = demo.dataset.pack;
      const img = demo.querySelector<HTMLButtonElement>(`.packs [data-pack="${pack}"]`);
      demo.classList.remove('shake'); void demo.offsetWidth; demo.classList.add('shake');
      if (pack !== 'silent' && img) {
        reaction.src = pack === 'wizard' ? '/img/reaction-wizard.jpg' : '/img/reaction-grumpyOldMan.jpg';
        demo.classList.add('react');
        clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => demo.classList.remove('react'), 1300);
      } else {
        demo.classList.add('nope-on');
        clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => demo.classList.remove('nope-on'), 1100);
      }
      status.innerHTML = `Blocked <b>${attempts}</b> attempt${attempts === 1 ? '' : 's'}. Use <b>Touch ID</b> (below) or <kbd>⌘</kbd><kbd>⇧</kbd><kbd>U</kbd> to unlock.`;
    };

    cast.addEventListener('click', (e) => { e.stopPropagation(); set('warded'); });
    touch.addEventListener('click', () => { if (demo.dataset.state === 'warded') set('idle'); });
    mac.addEventListener('pointerdown', (e) => {
      if (demo.dataset.state !== 'warded') return;
      e.preventDefault();
      intrude();
    });
    mac.addEventListener('keydown', (e) => {
      const k = e.key.toLowerCase();
      const combo = (e.metaKey || e.ctrlKey) && e.shiftKey;
      if (combo && k === 'l' && demo.dataset.state === 'idle') { e.preventDefault(); set('warded'); return; }
      if (demo.dataset.state !== 'warded') return;
      if (e.key === 'Tab') return; // keep keyboard navigation possible
      e.preventDefault();
      if (combo && k === 'u') set('idle');
      else if (!['shift', 'meta', 'control', 'alt'].includes(k)) intrude();
    });

    // ?demo=warded | wizard | grumpy | silent: open in that state (screenshots, links).
    const q = new URLSearchParams(location.search).get('demo');
    if (q) {
      set('warded');
      if (q !== 'warded') {
        choosePack(q);
        intrude();
        clearTimeout(hideTimer);
      }
    }

    for (const b of demo.querySelectorAll<HTMLButtonElement>('.packs button')) {
      b.addEventListener('click', () => choosePack(b.dataset.pack!));
    }
  }
</script>

<style>
  .demo { width: 100%; max-width: 860px; margin: 0 auto; }
  .mac {
    position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 14px;
    background: radial-gradient(120% 90% at 20% 0%, #1b3a30 0%, #0c1714 45%, #0b0d17 100%);
    border: 1px solid rgba(255,255,255,0.1); box-shadow: var(--shadow), 0 0 0 6px rgba(255,255,255,0.03);
    user-select: none; -webkit-user-select: none; outline: none; color: #e7efeb;
  }
  .mac:focus-visible { box-shadow: var(--shadow), 0 0 0 3px var(--accent); }
  @media (max-width: 560px) { .mac { aspect-ratio: 4 / 5; } }

  .menubar {
    position: absolute; inset: 0 0 auto 0; height: 26px; display: flex; align-items: center; gap: 14px;
    padding: 0 12px; font: 500 12px/1 var(--font); background: rgba(10,18,15,0.55); backdrop-filter: blur(8px); color: #dfe9e5; z-index: 1;
  }
  .menubar .apple { width: 11px; height: 13px; border-radius: 50% 50% 45% 45%; background: #dfe9e5; }
  .mb-strong { font-weight: 700; }
  .spacer { flex: 1; }
  .ward-icon { color: #dfe9e5; display: grid; place-items: center; transition: color 0.3s; }
  .demo[data-state='warded'] .ward-icon { color: #34c98e; }
  @media (max-width: 560px) { .hide-sm { display: none; } }

  .window {
    position: absolute; left: 5%; right: 5%; top: 44px; bottom: 7%;
    background: rgba(8, 14, 12, 0.92); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden;
    box-shadow: 0 20px 50px -20px rgba(0,0,0,0.7);
  }
  .titlebar { height: 28px; display: flex; align-items: center; gap: 7px; padding: 0 11px; background: rgba(255,255,255,0.04); font: 12px var(--font); color: #7e8e87; }
  .titlebar i { width: 11px; height: 11px; border-radius: 50%; background: #3a4541; }
  .titlebar i:nth-child(1) { background: #ec6a5e; } .titlebar i:nth-child(2) { background: #f4bf4f; } .titlebar i:nth-child(3) { background: #61c554; }
  .titlebar span { margin-left: auto; margin-right: auto; padding-right: 50px; }
  .term { margin: 0; padding: 14px 16px; font: clamp(10px, 1.55vw, 13px)/1.65 var(--mono); color: #cfe9de; white-space: pre-wrap; word-break: break-word; }

  /* Ward: readable glass over the live screen */
  .ward {
    position: absolute; inset: 0; z-index: 3; pointer-events: none; opacity: 0;
    transition: opacity 0.45s ease;
    background:
      radial-gradient(60% 50% at 50% 50%, rgba(111,227,180,0.10), transparent 70%),
      linear-gradient(135deg, rgba(159,231,205,0.16), rgba(63,174,138,0.05) 60%, rgba(111,227,180,0.10));
    backdrop-filter: blur(0.7px) saturate(1.25) brightness(0.92);
    -webkit-backdrop-filter: blur(0.7px) saturate(1.25) brightness(0.92);
    box-shadow: inset 0 0 0 1.5px rgba(111,227,180,0.35), inset 0 0 80px rgba(52,201,142,0.18);
  }
  .demo[data-state='warded'] .ward { opacity: 1; }
  .sheen {
    position: absolute; inset: -50%; opacity: 0.55;
    background: linear-gradient(115deg, transparent 42%, rgba(255,255,255,0.13) 48%, rgba(189,246,226,0.06) 52%, transparent 58%);
    animation: sweep 5.5s ease-in-out infinite;
  }
  .sheen.s2 { animation-delay: -2.7s; opacity: 0.3; }
  @keyframes sweep { from { transform: translateX(-35%); } to { transform: translateX(35%); } }
  .badge {
    position: absolute; top: 36px; left: 50%; transform: translateX(-50%);
    display: inline-flex; align-items: center; gap: 7px; padding: 7px 13px; border-radius: 999px;
    font: 600 12px/1 var(--font); color: #eafff6; background: rgba(12, 40, 31, 0.72);
    border: 1px solid rgba(111,227,180,0.45); box-shadow: 0 0 30px rgba(52,201,142,0.35);
    animation: pulse 2.6s ease-in-out infinite; white-space: nowrap;
  }
  .badge svg { color: #6fe3b4; }
  @keyframes pulse { 50% { box-shadow: 0 0 44px rgba(52,201,142,0.6); } }
  .hint {
    position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); white-space: nowrap;
    font: 500 12px/1 var(--font); color: #dfe9e5; background: rgba(8,14,12,0.7); padding: 7px 12px; border-radius: 999px;
    display: flex; gap: 5px; align-items: center;
  }
  .hint kbd { background: rgba(255,255,255,0.1); color: #eafff6; border-color: rgba(255,255,255,0.18); font-size: 11px; }

  .reaction {
    position: absolute; inset: 0; z-index: 4; pointer-events: none; opacity: 0; transform: scale(1.06);
    transition: opacity 0.18s ease, transform 0.25s ease;
  }
  .reaction img { width: 100%; height: 100%; object-fit: cover; }
  .demo.react .reaction { opacity: 1; transform: scale(1); }
  .nope {
    position: absolute; z-index: 4; inset: 0; display: grid; place-items: center; opacity: 0;
    background: rgba(13,13,13,0.92); box-shadow: inset 0 0 0 6px #e24b4a;
    font: 800 clamp(18px, 4vw, 34px)/1 var(--font); letter-spacing: 0.12em; color: #e24b4a;
    pointer-events: none; transition: opacity 0.15s ease;
  }
  .demo.nope-on .nope { opacity: 1; }
  .demo.shake .mac { animation: shake 0.35s ease; }
  @keyframes shake { 20% { transform: translateX(-5px); } 40% { transform: translateX(5px); } 60% { transform: translateX(-3px); } 80% { transform: translateX(3px); } }

  .cast {
    position: absolute; z-index: 5; left: 50%; bottom: 13%; transform: translateX(-50%);
    display: inline-flex; align-items: center; gap: 9px; padding: 12px 18px; border-radius: 999px; border: 0; cursor: pointer;
    font: 650 14px/1 var(--font); color: #062117; background: #34c98e; box-shadow: 0 10px 40px -8px rgba(52,201,142,0.9);
    transition: opacity 0.3s ease, transform 0.2s ease; white-space: nowrap;
  }
  .cast:hover { transform: translateX(-50%) translateY(-2px); }
  .cast .keys { display: inline-flex; gap: 3px; }
  .cast kbd { background: rgba(6,33,23,0.14); border-color: rgba(6,33,23,0.25); color: #062117; font-size: 11px; min-width: 1.6em; }
  .demo[data-state='warded'] .cast { opacity: 0; pointer-events: none; }
  @media (max-width: 560px) { .cast .keys { display: none; } }

  .deck { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; }
  .packs { display: flex; flex-wrap: wrap; gap: 6px; }
  .packs button {
    border: 1px solid var(--border); background: var(--surface); color: var(--muted);
    padding: 7px 12px; border-radius: 999px; font: 500 0.82rem/1 var(--font); cursor: pointer;
  }
  .packs button[aria-checked='true'] { color: var(--text); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .touchid {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px 8px 10px; border-radius: 12px; cursor: pointer;
    border: 1px solid var(--border); background: var(--surface-2); color: var(--muted); font: 600 0.85rem var(--font);
    transition: all 0.2s;
  }
  .demo[data-state='warded'] .touchid { color: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); }
  .status { text-align: center; margin: 14px 0 0; min-height: 1.5em; }
</style>
