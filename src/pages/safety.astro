---
import Prose from '../layouts/Prose.astro';
import { remoteMarkdown } from '../lib/remote-md';
import { site } from '../site.config';
// Rendered from the public repo's SAFETY.md at build time. Edit it in the app repo, never here.
const { title, html } = await remoteMarkdown('SAFETY.md');
---
<Prose title={title} eyebrow="Safety" description="Every way out of a Wardlume ward, what it blocks, and what it deliberately can't." source={`${site.links.github}/blob/main/SAFETY.md`}>
  <Fragment set:html={html} />
</Prose>
