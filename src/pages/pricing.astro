---
import Base from '../layouts/Base.astro';
import { pricing, site } from '../site.config';
import Email from '../components/Email.astro';
import FAQ from '../components/FAQ.astro';
const free = pricing.mode === 'free';
const p = pricing.paid;
const buyHref = p.checkoutURL || '/support#contact';
const sale = p.saleLabel && (p.saleEnds ? `${p.saleLabel} until ${p.saleEnds}` : p.saleLabel);
const paidFaq = [
  { q: 'What happens after the trial?',
    a: `Every feature works for ${p.trialHours} hours, no card needed. After that the ward won't start until you buy a license. Your settings are kept, and a ward that's already up is never interrupted.` },
  { q: 'How many Macs can I use it on?',
    a: `One license covers up to ${p.macs} Macs you own or use, for personal or work use.` },
  { q: 'I got a new Mac. Can I move my license?',
    a: 'Yes. On the old Mac open <b>Settings → License → Remove from This Mac</b>, then enter the same key on the new one.' },
  { q: 'Can I get a refund?',
    a: `Yes, a full refund within ${p.refundDays} days, no questions asked. See the <a href="/refunds">Refund Policy</a>.` },
  { q: 'I used Wardlume before it was paid.',
    a: 'Thank you! Updating from a free 1.x version makes you a <b>Founder</b>: Pro is yours, free, for good. Nothing to do.' },
  { q: 'Do I get a receipt or invoice?',
    a: 'Yes. Checkout is run by Lemon Squeezy, our reseller, which emails a receipt and tax invoice. You can add a company name and tax ID at checkout.' },
  { q: 'Does the app go online to check my license?',
    a: 'No. Your key is checked on your Mac against a signature built into Wardlume, which stays blocked from the internet. See <a href="/privacy">Privacy</a>.' },
];
---
<Base title="Pricing" description={free
  ? 'Wardlume is free for personal and other noncommercial use. Sponsor its development, or ask about a commercial license.'
  : `Try Wardlume free for ${p.trialHours} hours, then buy once: ${p.price} for ${p.macs} Macs, every update included. ${p.refundDays}-day refunds.`}>
  <div class="container page">
    <header class="center intro">
      <span class="eyebrow">Pricing</span>
      {free ? (
        <>
          <h1>Free for personal use.</h1>
          <p class="lead">Every feature, no trial, no account. If Wardlume keeps your agents safe, you can help keep it going.</p>
        </>
      ) : (
        <>
          <h1>Pay once. Keep it.</h1>
          <p class="lead">Try every feature free for {p.trialHours} hours. No card, no account. Then one price, no subscription.</p>
        </>
      )}
    </header>

    {free ? (
      <div class="grid grid-3 plans">
        <div class="card plan highlight">
          <h2>Personal</h2>
          <p class="price">$0</p>
          <p class="muted small">Personal, study, hobby, nonprofit and education use.</p>
          <ul>
            <li>Every feature</li>
            <li>All future updates</li>
            <li>Touch ID &amp; Apple Watch unlock</li>
            <li>Reaction packs &amp; custom packs</li>
          </ul>
          <a class="btn btn-primary" href="/download">Download</a>
        </div>
        <div class="card plan">
          <h2>Supporter</h2>
          <p class="price">Any amount</p>
          <p class="muted small">Same app. Your support pays for Apple notarization and new features.</p>
          <ul>
            {pricing.donate.map((d) => <li>{d.note}</li>)}
          </ul>
          <div class="stack">
            {pricing.donate.map((d, i) => <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-ghost'}`} href={d.href}>💚 {d.label}</a>)}
          </div>
        </div>
        <div class="card plan soon">
          <h2>Commercial <span class="badge">Coming soon</span></h2>
          <p class="price">Coming soon</p>
          <p class="muted small">For using Wardlume at work for a company, or bundling it into a paid product or service.</p>
          <ul>
            <li>License for your team</li>
            <li>Priority help</li>
            <li>Invoice on request</li>
          </ul>
          <p class="small ask">Interested? Email me at <Email subject="Wardlume commercial license" /> and I’ll get back to you.</p>
          <Email subject="Wardlume commercial license" label="✉️ Email me" class="btn btn-ghost" />
        </div>
      </div>
    ) : (
      <>
        <div class="card plan highlight solo">
          {sale && <span class="sale">{sale}</span>}
          <h2>{p.product} · {p.plan}</h2>
          <p class="price">
            {p.listPrice && <s class="was" aria-label={`was ${p.listPrice}`}>{p.listPrice}</s>}
            {p.price}<span class="small muted"> one-time</span>
          </p>
          <p class="muted small">For up to {p.macs} Macs · every update included · personal or work use</p>
          <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
          <div class="stack">
            <a class={`btn btn-primary ${p.checkoutURL ? 'lemonsqueezy-button' : ''}`} href={buyHref}>Buy {p.product} · {p.price}</a>
            <a class="btn btn-ghost" href="/download">Try it free for {p.trialHours} hours</a>
          </div>
          <p class="small muted secure">Secure checkout by Lemon Squeezy. Taxes are added at checkout. <a href="/refunds">{p.refundDays}-day refunds</a>.</p>
        </div>

        <ol class="steps grid grid-3">
          <li class="card"><b>1 · Try it</b><span class="muted small">Download and use every feature free for {p.trialHours} hours.</span></li>
          <li class="card"><b>2 · Buy once</b><span class="muted small">{p.price}, paid once. No subscription, no account.</span></li>
          <li class="card"><b>3 · Activate</b><span class="muted small">Your key arrives by email. One click activates it.</span></li>
        </ol>

        <section class="faq-wrap">
          <h2 class="center">Questions</h2>
          <FAQ items={paidFaq} />
        </section>
        {p.checkoutURL && <script is:inline src="https://app.lemonsqueezy.com/js/lemon.js" defer></script>}
      </>
    )}

    {free ? (
      <p class="center small muted fine">
        Wardlume is licensed under <a href={`https://github.com/${site.repo}/blob/main/LICENSE`}>PolyForm Noncommercial 1.0.0</a>. See <a href="/terms">Terms</a> for what counts as commercial use.
      </p>
    ) : (
      <p class="center small muted fine">
        Prices in US dollars. See the <a href="/terms">Terms of Use</a> and <a href="/refunds">Refund Policy</a>.
      </p>
    )}
  </div>
</Base>

<style>
  .page { padding-top: 56px; padding-bottom: 40px; }
  .intro { margin-bottom: 40px; }
  .plans { align-items: stretch; }
  .plan { display: flex; flex-direction: column; padding: 28px; }
  .plan.highlight { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), var(--shadow); }
  .plan h2 { font-size: 1.1rem; color: var(--muted); margin-bottom: 8px; }
  .price { font-size: 2.2rem; font-weight: 750; letter-spacing: -0.02em; margin: 0 0 8px; }
  .plan ul { padding-left: 1.1em; margin: 8px 0 24px; flex: 1; }
  .plan li { margin: 6px 0; font-size: 0.93rem; }
  .plan li::marker { color: var(--accent); }
  .stack { display: grid; gap: 8px; }
  .soon ul { opacity: 0.7; margin-bottom: 12px; }
  .ask { margin: 0 0 14px; color: var(--muted); }
  .ask :global(a) { font-weight: 600; white-space: nowrap; }
  .badge {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em; vertical-align: middle; margin-left: 6px;
    padding: 3px 8px; border-radius: 999px; color: var(--warn); border: 1px solid color-mix(in srgb, var(--warn) 45%, transparent);
  }
  .fine { margin-top: 36px; }
  .solo { max-width: 460px; margin: 0 auto; position: relative; }
  .sale {
    align-self: flex-start; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 999px; margin-bottom: 12px;
    color: var(--accent-ink); background: var(--accent);
  }
  .was { color: var(--faint); font-weight: 500; font-size: 1.4rem; margin-right: 10px; }
  .secure { margin: 14px 0 0; text-align: center; }
  .steps { list-style: none; padding: 0; margin: 40px auto 0; max-width: 900px; }
  .steps li { display: grid; gap: 6px; padding: 18px 20px; }
  .faq-wrap { margin-top: 56px; }
  .faq-wrap h2 { margin-bottom: 8px; }
</style>
