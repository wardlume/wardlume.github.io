---
import Prose from '../layouts/Prose.astro';
import { remoteMarkdown } from '../lib/remote-md';
import { site } from '../site.config';
// Rendered from the public repo's PRIVACY.md at build time. Edit it in the app repo, never here.
const { title, html } = await remoteMarkdown('PRIVACY.md');
---
<Prose title={title} eyebrow="Legal" description="Wardlume is local-only: no servers, no analytics, no accounts." source={`${site.links.github}/blob/main/PRIVACY.md`}>
  <Fragment set:html={html} />
</Prose>
