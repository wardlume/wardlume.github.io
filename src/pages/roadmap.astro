---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { latestRelease } from '../lib/release';
const r = await latestRelease();

// Coming-soon list. No dates on purpose: things ship when they're solid.
const groups = [
  {
    title: 'Up next',
    tag: 'soon',
    items: [
      { icon: '🎬', t: 'Screenshots & demo video', d: 'Real screenshots of the ward, Settings, and reactions, plus a short clip of a ward in action.' },
      { icon: '✅', t: 'Apple notarization', d: 'Signed and notarized by Apple, so direct downloads open with no “damaged” prompt or extra step.' },
      { icon: '💼', t: 'Commercial license', d: 'A simple license for teams and companies, with priority help and invoices.' },
    ],
  },
  {
    title: 'Planned',
    tag: 'planned',
    items: [
      { icon: '📱', t: 'Walk-away lock with your phone', d: 'Pair your iPhone or Android phone once in Bluetooth settings. Walk away and the ward goes up by itself. (Unlocking stays Touch ID or Apple Watch.)' },
      { icon: '🍺', t: 'Official Homebrew cask', d: 'Install with a plain brew install --cask wardlume, no tap needed.' },
    ],
  },
  {
    title: 'Exploring',
    tag: 'idea',
    items: [
      { icon: '🤖', t: 'Agent status on the ward', d: 'See whether Claude Code or Codex is Working, Needs input, or Finished, right on the glass, with an optional sound.' },
      { icon: '🧠', t: 'Agent-aware auto-ward', d: 'Only auto-ward while an AI agent is actually running.' },
      { icon: '🔕', t: 'Hide notifications while warded', d: 'Turn on a Focus mode during the ward so message banners can’t leak.' },
      { icon: '📋', t: 'Session summary on unlock', d: 'How long you were away, when the agent finished, and any intrusion attempts.' },
      { icon: '🖥️', t: 'Glass ward on every monitor', d: 'The full animated glass on all displays, not just the one you activate from.' },
      { icon: '⌨️', t: 'Command line & URL scheme', d: 'wardlume lock from a script, or open wardlume://lock from anywhere.' },
      { icon: '🔋', t: 'Power guard', d: 'A heads-up when you ward on battery without a charger.' },
    ],
  },
];
const labels: Record<string, string> = { soon: 'Coming soon', planned: 'Planned', idea: 'Exploring' };
---
<Base title="Roadmap" description="What's coming to Wardlume: notarization, demo video, commercial license, phone walk-away lock, agent status, and more.">
  <div class="container page">
    <header class="center intro">
      <span class="eyebrow">Roadmap</span>
      <h1>What’s coming to Wardlume</h1>
      <p class="lead">Currently on v{r.version}. Here’s what’s next. Have an idea or want to vote on one? Say so in <a href={site.links.discussions}>Discussions</a>.</p>
    </header>

    {groups.map((g) => (
      <section class="group">
        <h2>{g.title}</h2>
        <div class="grid grid-2">
          {g.items.map((i) => (
            <div class="card item">
              <span class="ico">{i.icon}</span>
              <div>
                <h3>{i.t} <span class={`badge ${g.tag}`}>{labels[g.tag]}</span></h3>
                <p class="muted small">{i.d}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <p class="center muted small shipped">Already shipped: see the <a href="/changelog">changelog</a>.</p>
  </div>
</Base>

<style>
  .page { padding-top: 56px; padding-bottom: 40px; }
  .intro { margin-bottom: 24px; }
  .group { margin-top: 40px; }
  .group h2 { font-size: 1.4rem; margin-bottom: 16px; }
  .item { display: flex; gap: 14px; align-items: flex-start; }
  .item p { margin: 0; }
  .item h3 { margin-bottom: 6px; }
  .ico { font-size: 1.5rem; line-height: 1.2; }
  .badge {
    display: inline-block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.03em; vertical-align: middle;
    padding: 2px 8px; border-radius: 999px; margin-left: 4px; white-space: nowrap; border: 1px solid;
  }
  .badge.soon { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .badge.planned { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 45%, transparent); }
  .badge.idea { color: var(--muted); border-color: var(--border); }
  .shipped { margin-top: 48px; }
</style>
