---
import Base from '../layouts/Base.astro';
import GlassDemo from '../components/GlassDemo.astro';
import Cmd from '../components/Cmd.astro';
import FAQ from '../components/FAQ.astro';
import SocialProof from '../components/SocialProof.astro';
import Icon from '../components/Icon.astro';
import Scene from '../components/Scene.astro';
import { site } from '../site.config';
import { faq } from '../lib/faq';
import { latestRelease, formatDate, totalDownloads } from '../lib/release';

const r = await latestRelease();
const downloads = (await totalDownloads()) + site.downloads.extra;
const showDownloads = site.downloads.show && downloads >= site.downloads.minimum;

const offer = 'Free for personal use';

// The five questions that most often stand between a visitor and a download.
// The full list lives on the Support page.
const topFaq = faq.filter((f) => /lock screen|get stuck|Claude Code|safe\?|free\?/i.test(f.q));

const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&');
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: plain(f.a) },
  })),
};

// Playful scenarios, not testimonials.
const scenes = [
  { scene: 'cat', q: 'The cat walked across the keyboard and approved the migration.', who: 'a cat, probably' },
  { scene: 'cafe', q: 'Someone at the café typed “hello?” into my agent’s prompt.', who: 'shared table, Tuesday' },
  { scene: 'kid', q: 'My kid pressed Escape. Forty minutes of work, gone.', who: 'every parent who codes' },
  { scene: 'brush', q: 'I brushed the trackpad and pasted my clipboard into prod.', who: 'a sleeve, allegedly' },
  { scene: 'sleep', q: 'My Mac fell asleep and took the training run with it.', who: 'hour three of five' },
  { scene: 'coworker', q: 'A coworker “just checked something” on my laptop.', who: 'open-plan office' },
] as const;

const compare = [
  ['Screen stays visible', true, false],
  ['Agents keep working in view', true, false],
  ['Mac stays awake', true, false],
  ['Reacts when someone touches it', true, false],
  ['Blocks keyboard, mouse & gestures', true, true],
];

const extras = [
  { icon: 'camera', title: 'Intruder photo', text: 'Optional, off by default' },
  { icon: 'eye', title: 'Keeps Mac awake', text: 'No idle sleep while warded' },
  { icon: 'timer', title: 'Auto-ward', text: 'After 1–15 idle minutes' },
  { icon: 'monitor', title: 'Every display', text: 'Unplugging never unlocks' },
  { icon: 'key', title: 'Your shortcuts', text: 'Remap lock and unlock' },
  { icon: 'wifi-off', title: 'Local only', text: 'No accounts, no analytics' },
] as const;

const appleLogo = 'M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.2 1-4 2.5-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.6-4ZM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.6 2.8-1.4Z';
---
<Base
  exactTitle
  title="Wardlume: lock your Mac's keyboard & mouse while AI agents run"
  description="Free Mac app that locks your keyboard, mouse and trackpad while Claude Code, Codex or Cursor keep working in view. Unlock with Touch ID or Apple Watch."
  jsonLd={[faqLd]}
>
  <!-- 1. Hero: promise, proof, download; the working demo on the right -->
  <section class="hero">
    <div class="container split middle">
      <div class="hero-copy">
        <div class="chips">
          <a class="release" href="/changelog">
            <span class="tag">New in v{r.version}</span> {site.banner.latest} <Icon name="arrow" size={14} />
          </a>
          <a class="release" href={site.banner.always.href}>
            <span class="tag soft"><Icon name={site.banner.always.icon} size={13} /></span> {site.banner.always.text} <span class="since">· since {site.banner.always.since}</span> <Icon name="arrow" size={14} />
          </a>
        </div>
        <h1>Lock the input.<br />Keep the work <em class="nowrap">in view.</em></h1>
        <p class="lead">A glass ward over your Mac while Claude Code, Codex or Cursor keep working. Keys, clicks and gestures are blocked; Touch ID or your Apple Watch lets you back in.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/download">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d={appleLogo} /></svg>
            Download for Mac
          </a>
          <a class="btn btn-ghost brew-btn" href="#install">Install with Homebrew</a>
        </div>
        <div class="hero-proof">
          {showDownloads && <SocialProof variant={site.downloads.variant} count={downloads} />}
          <p class="meta">{offer}<br />{site.requirements}{r.date && <><br />v{r.version}, {formatDate(r.date)}</>}</p>
        </div>
      </div>
      <div class="hero-demo">
        <GlassDemo />
      </div>
    </div>
  </section>

  <!-- 2. The pain, in one glance -->
  <section class="section scenes-section">
    <div class="container">
      <div class="head center-head">
        <span class="eyebrow">Things you won’t say again</span>
        <h2>You’ve lived at least one of these.</h2>
      </div>
      <ul class="scenes">
        {scenes.map((s) => (
          <li>
            <div class="art"><Scene name={s.scene} label={s.q} /></div>
            <blockquote>{s.q}</blockquote>
            <span class="who">— {s.who}</span>
          </li>
        ))}
      </ul>
      <div class="mid-cta">
        <a class="btn btn-primary" href="/download">Make it the last time <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- 3. How it works -->
  <section class="section band" id="how-it-works">
    <div class="container">
      <div class="head">
        <span class="eyebrow">How it works</span>
        <h2>One shortcut in. Touch&nbsp;ID out.</h2>
      </div>
      <ol class="steps">
        <li>
          <span class="step-key"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>L</kbd></span>
          <h3>Lock</h3>
          <p>From anywhere, even inside your editor.</p>
        </li>
        <li>
          <span class="step-key"><Icon name="walk" /></span>
          <h3>Step away</h3>
          <p>Input blocked on every display. Screen stays on.</p>
        </li>
        <li>
          <span class="step-key"><Icon name="fingerprint" /><Icon name="watch" /></span>
          <h3>Unlock</h3>
          <p>Touch ID, Apple Watch or your password.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 4. Why not just lock the screen? -->
  <section class="section" id="features">
    <div class="container split middle">
      <div class="head">
        <span class="eyebrow">Why not just lock the screen?</span>
        <h2>Your screen stays on. Your input doesn’t.</h2>
        <p class="lead">The lock screen hides your work and lets your Mac sleep. Wardlume blocks only the hands, behind see-through Clear glass that needs no screen recording.</p>
      </div>
      <div class="table-card">
        <table class="compare">
          <thead><tr><th><span class="sr">Feature</span></th><th>Wardlume</th><th>Lock screen</th></tr></thead>
          <tbody>
            {compare.map(([label, a, b]) => (
              <tr>
                <td>{label}</td>
                <td class={a ? 'yes' : 'no'}>{a ? <Icon name="check" size={18} label="Yes" /> : <span aria-label="No">—</span>}</td>
                <td class={b ? 'yes dim' : 'no'}>{b ? <Icon name="check" size={18} label="Yes" /> : <span aria-label="No">—</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 5. Reactions: the fun part, image first -->
  <section class="section band">
    <div class="container split middle">
      <div class="head">
        <span class="eyebrow">Reactions</span>
        <h2>A little mischief for whoever touches it.</h2>
        <p class="lead">Wizard, Grumpy Old Man, Silent Professional, or your own image and sound.</p>
      </div>
      <div class="reactions">
        <figure><img src="/img/reaction-wizard.jpg" alt="Wizard reaction pack: a glowering wizard" loading="lazy" width="1200" height="686" /><figcaption>Wizard</figcaption></figure>
        <figure><img src="/img/reaction-grumpyOldMan.jpg" alt="Grumpy Old Man reaction pack: a stern stare" loading="lazy" width="1200" height="686" /><figcaption>Grumpy Old Man</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- 6. Also included -->
  <section class="section-sm">
    <div class="container">
      <p class="eyebrow strip-label">Also included</p>
      <ul class="extras">
        {extras.map((f) => (
          <li><Icon name={f.icon} /><b>{f.title}</b><span>{f.text}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7. Trust: private and safe -->
  <section class="section band">
    <div class="container">
      <div class="head">
        <span class="eyebrow">Trust</span>
        <h2>Private by design. Never a trap.</h2>
      </div>
      <div class="trust">
        <div class="card">
          <Icon name="wifi-off" />
          <h3>Your screen can’t leave your Mac</h3>
          <p>macOS itself blocks Wardlume from the internet: it’s sandboxed with no network entitlement. Only a separate updater goes online, for signed updates. Check it yourself:</p>
          <Cmd lines="codesign -d --entitlements - /Applications/Wardlume.app" />
          <a class="more-link" href="/privacy">How to read the result <Icon name="arrow" size={14} /></a>
        </div>
        <div class="card">
          <Icon name="life-buoy" />
          <h3>There’s always a way out</h3>
          <p>Touch ID, Apple Watch, your password, or <kbd>⌘</kbd><kbd>⌥</kbd><kbd>Esc</kbd> Force Quit, which macOS reserves so no app can block it. Sleep always ends the ward.</p>
          <a class="more-link" href="/safety">Safety guide <Icon name="arrow" size={14} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FAQ: the five questions that block a download -->
  <section class="section" id="faq">
    <div class="container split">
      <div class="head sticky">
        <span class="eyebrow">FAQ</span>
        <h2>Before you trust it with your keyboard.</h2>
        <p class="lead"><a href="/support">More questions on the support page</a>.</p>
      </div>
      <FAQ items={topFaq} />
    </div>
  </section>

  <!-- 9. Final call to action, with Homebrew -->
  <section class="section band" id="install">
    <div class="container final">
      <div class="final-copy">
        <h2>Cast your first ward.</h2>
        <p class="lead">Free for personal use. Ready in a minute: a guided setup asks for two permissions, no screen recording.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/download">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d={appleLogo} /></svg>
            Download for Mac
          </a>
          <a class="btn btn-ghost" href="/pricing">Support the project</a>
        </div>
        {showDownloads && <SocialProof variant="inline" count={downloads} />}
      </div>
      <div class="final-brew">
        <p class="brew-label">Or with Homebrew</p>
        <Cmd lines={['brew tap arpitagarwal1301/tap', 'brew trust arpitagarwal1301/tap', 'brew install --cask wardlume']} />
        <p class="small muted">{site.requirements} · <a href="/download">.pkg and .dmg</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* 1. Hero */
  .hero { padding: 36px 0 32px; }
  @media (max-width: 559px) { .brew-btn { display: none; } .release { font-size: 0.82rem; } }
  @media (min-width: 960px) {
    .hero { padding: 64px 0 72px; }
    .hero .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.18fr); gap: 56px; }
    .hero h1 { font-size: clamp(3rem, 4.4vw, 4rem); }
  }
  .chips { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-bottom: 26px; }
  .release { display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--muted); }
  .release:hover { color: var(--text); text-decoration: none; }
  .tag { white-space: nowrap; font: 600 0.7rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); background: var(--accent-soft); padding: 5px 8px; border-radius: 6px; }
  .tag.soft { display: inline-flex; padding: 3px 5px; }
  .since { color: var(--faint); }
  .hero h1 { margin-bottom: 22px; }
  .hero h1 em { color: var(--accent); }
  .nowrap { white-space: nowrap; }
  .hero .lead { margin: 0 0 30px; }
  .hero-proof { display: flex; align-items: center; gap: 18px 22px; flex-wrap: wrap; margin-top: 26px; }
  .hero-proof :global(.sp-laurel) { margin: 0; }
  .hero-proof :global(.sp-laurel b) { font-size: 2.5rem; }
  .meta { margin: 0; font-size: 0.82rem; line-height: 1.55; color: var(--faint); }
  .hero-proof :global(.sp-laurel) + .meta { padding-left: 22px; border-left: 1px solid var(--border-strong); }
  .hero-demo { min-width: 0; }

  /* 2. Scenes */
  .scenes-section { border-top: 1px solid var(--border); }
  .center-head { margin-left: auto; margin-right: auto; text-align: center; max-width: 760px; }
  .scenes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (min-width: 960px) { .scenes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; } }
  .scenes li { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 10px 12px; }
  @media (min-width: 960px) { .scenes li { padding: 20px 22px 22px; } }
  .art { background: var(--bg-2); border-radius: 10px; padding: 8px 6px; margin-bottom: 10px; }
  @media (min-width: 960px) { .art { padding: 12px 10px; margin-bottom: 14px; } }
  .scenes blockquote { margin: 0 0 8px; font: 500 0.92rem/1.28 var(--serif); letter-spacing: -0.01em; }
  @media (min-width: 960px) { .scenes blockquote { font-size: 1.25rem; } }
  .who { margin-top: auto; font: 0.68rem/1.3 var(--mono); color: var(--faint); }
  @media (min-width: 960px) { .who { font-size: 0.72rem; } }
  .mid-cta { display: flex; justify-content: center; margin-top: 32px; }
  @media (min-width: 960px) { .mid-cta { margin-top: 44px; } }

  /* 3. Steps */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0 32px; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .steps li { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 16px; align-items: center; padding: 18px 0; border-top: 1px solid var(--border-strong); }
  @media (min-width: 760px) { .steps li { grid-template-columns: 1fr; padding: 24px 0 8px; row-gap: 6px; } }
  .step-key { grid-row: span 2; display: inline-flex; gap: 6px; align-items: center; color: var(--accent); min-width: 72px; font-size: 1.05rem; }
  .step-key :global(.icon) { width: 30px; height: 30px; }
  @media (min-width: 760px) { .step-key { grid-row: auto; margin-bottom: 12px; min-height: 36px; } }
  .steps h3 { margin: 0; font-size: 1.15rem; }
  .steps p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  /* 4. Compare table */
  .table-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 4px 16px; overflow-x: auto; }
  .compare { width: 100%; border-collapse: collapse; font-size: 0.9rem; line-height: 1.35; }
  @media (min-width: 960px) { .compare { font-size: 0.98rem; } }
  .compare th, .compare td { padding: 12px 6px; border-bottom: 1px solid var(--border); text-align: center; }
  .compare tr:last-child td { border-bottom: 0; }
  .compare th:first-child, .compare td:first-child { text-align: left; padding-left: 0; }
  .compare th { color: var(--muted); font-size: 0.78rem; font-weight: 600; font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.06em; }
  .compare th:nth-child(2) { color: var(--accent); }
  .compare td :global(.icon) { margin: 0 auto; color: var(--accent); stroke-width: 2.2; }
  .compare .dim :global(.icon) { color: var(--faint); }
  .compare .no { color: var(--faint); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* 5. Reactions */
  .reactions { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .reactions figure { margin: 0; }
  .reactions img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--border); }
  .reactions figure:nth-child(2) { margin-top: 24px; }
  @media (min-width: 960px) { .reactions figure:nth-child(2) { margin-top: 40px; } }
  .reactions figcaption { margin-top: 10px; font: 600 0.75rem/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); }

  /* 6. Also included */
  .strip-label { display: block; margin-bottom: 14px; }
  .extras { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; border-top: 1px solid var(--border-strong); }
  @media (min-width: 720px) { .extras { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1100px) { .extras { grid-template-columns: repeat(6, 1fr); } }
  .extras li { display: grid; grid-template-columns: 22px 1fr; column-gap: 10px; padding: 16px 0; border-bottom: 1px solid var(--border); }
  @media (min-width: 1100px) { .extras li { border-bottom: 0; padding-top: 20px; } }
  .extras :global(.icon) { color: var(--accent); grid-row: span 2; }
  .extras b { font-size: 0.95rem; font-weight: 600; }
  .extras span { font-size: 0.82rem; color: var(--muted); }

  /* 7. Trust */
  .trust { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .trust > * { min-width: 0; }
  @media (min-width: 860px) { .trust { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; } }
  .trust .card { display: flex; flex-direction: column; gap: 10px; padding: 24px; }
  .trust .card > :global(.icon) { color: var(--accent); width: 26px; height: 26px; }
  .trust h3 { margin: 4px 0 0; font-size: 1.15rem; }
  .trust p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .more-link { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 6px; font-weight: 600; font-size: 0.92rem; }

  /* 9. Final CTA */
  .final { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .final > * { min-width: 0; }
  @media (min-width: 960px) { .final { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; align-items: center; } }
  .final .lead { margin: 0 0 24px; }
  .final-copy :global(.sp-inline) { margin-top: 20px; }
  .brew-label { font: 600 0.72rem var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); margin: 0 0 10px; }
  .final-brew .small { margin: 12px 0 0; }
</style>
